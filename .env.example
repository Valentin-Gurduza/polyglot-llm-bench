# =============================================================================
# Polyglot-LLM-Bench — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# =============================================================================

# ── OpenRouter API ───────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_ACTUAL_KEY

# Base URL (default — no need to change unless using a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── App Identity (optional, used for OpenRouter rankings) ────────────────────
APP_REFERER=https://github.com/your-username/polyglot-llm-bench
APP_TITLE=Polyglot-LLM-Bench
